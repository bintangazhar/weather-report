# Weather Monitor for Pontianak - Environment Variables
# Priority: OpenWeatherMap (requires API key) → Open-Meteo (free) → wttr.in (free)

# OpenWeatherMap API Key - PRIMARY (free tier: https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (your user ID or group ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Rain probability threshold (0.0 - 1.0), default 0.5 = 50%
RAIN_THRESHOLD=0.5

# Check interval in seconds, default 3600 = 1 hour
CHECK_INTERVAL=3600